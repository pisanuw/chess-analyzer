# Copy to .env for local config (.env is gitignored). On the Netlify mirror, set
# these in the Netlify dashboard (Site settings -> Environment variables) on the
# function, not in this file. Every value is optional: with none set, the app
# runs open locally with the operator acting as admin (the pre-multi-user behavior).

# --- Auth (multi-user) -------------------------------------------------------
# Enables login when set (or when APP_PASSWORD is set). Any long random string,
# e.g. `openssl rand -base64 32`. Must stay stable or existing sessions break.
SESSION_SECRET=

# Base URL the app is reached at: used to build the Google redirect URI and
# magic-link URLs. Local: http://localhost:3210   Mirror: https://<site>.netlify.app
PUBLIC_URL=

# The login allowlist: each member's and the admin's login email(s),
# comma-separated for more than one. Only these addresses can sign in.
AUTH_EMAIL_KAI=
AUTH_EMAIL_NIKASH=
AUTH_EMAIL_NEERAJ=
AUTH_EMAIL_YUSUF=

# --- Google sign-in (optional; omit both to hide the Google button) ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorized redirect URI must be exactly:
#   <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Override the derived redirect URI only if it must differ from PUBLIC_URL:
# GOOGLE_REDIRECT_URI=

# --- Magic-link email via Resend (optional; omit to hide the email form) -----
# Without RESEND_API_KEY, requesting a link just logs it to the server console
# (fine for local testing). AUTH_FROM_EMAIL must be a Resend-verified sender.
RESEND_API_KEY=
AUTH_FROM_EMAIL="Chess Analyzer <login@example.com>"

# --- Legacy single password (optional) ---------------------------------------
# The old hosted gate. Still accepted as an admin login during the transition;
# remove once members sign in with Google or a magic link.
# APP_PASSWORD=

# --- Data / misc (optional) --------------------------------------------------
# DATA_DIR=./data            # where all user data lives
# DEFAULT_USER=kai           # the member that legacy/unscoped data belongs to
# READONLY_DATA=1            # hosted mirror: block game mutations (set by Netlify)
# SUPABASE_URL=              # hosted mirror drill store (set by Netlify)
# SUPABASE_SERVICE_KEY=
