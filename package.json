{
  "name": "chess-analyzer",
  "version": "0.2.0",
  "description": "Local chess game analyzer: Stockfish + LLM explanations, weakness report, drills",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/serve.js",
    "dev": "node --watch server/serve.js",
    "samples": "node scripts/make-samples.js 3 > samples/sample-games.pgn",
    "test": "node --test 'test/*.test.js'",
    "test:ui": "node test/ui/smoke.mjs",
    "lint": "eslint . && node scripts/check-prose.js",
    "check:prose": "node scripts/check-prose.js",
    "icons": "node scripts/make-icons.js",
    "pull-data": "git -C data pull --rebase",
    "push-data": "git -C data add -A && (git -C data diff --cached --quiet || git -C data commit -m sync) && git -C data push",
    "sync": "npm run pull-data && npm start",
    "publish-web": "bash scripts/publish-web.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pisanuw/chess-analyzer.git"
  },
  "keywords": [
    "chess",
    "stockfish",
    "analysis",
    "claude",
    "training",
    "drills"
  ],
  "author": "Yusuf Pisan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pisanuw/chess-analyzer/issues"
  },
  "homepage": "https://github.com/pisanuw/chess-analyzer#readme",
  "type": "module",
  "dependencies": {
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "express": "^5.2.1",
    "serverless-http": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "globals": "16.4.0",
    "playwright": "^1.63.0"
  }
}
